PORT=8080
DB_TYPE=sqlite
DB_NAME=:memory:

# Postgres profile
# DB_TYPE=postgres
# DB_HOST=localhost
# DB_PORT=5557
# DB_USER=postgres
# DB_PASS=postgres
# DB_NAME=zkissuer

ISSUER=http://zkissuer.local
TOKEN_VALIDITY_HOURS=24

# Optional: provide private JWK JSON directly
# ECDSA_PRIVATE_JWK={"kty":"EC","crv":"P-256","x":"...","y":"...","d":"..."}

# Optional: provide private JWK file paths
ECDSA_PRIVATE_JWK_PATH=./keys/ecdsa-private.jwk.json

# Optional: provide ZK private key directly (hex or decimal)
# ZK_PRIVATE_KEY=<64_hex_chars_or_decimal>

# Optional: provide ZK private key file path
ZK_PRIVATE_KEY_PATH=./keys/zk-private.key.dec
